# ===========================================
# Brick Manufacturing ERP - Environment Config
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=
# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Business Defaults (in rupees 1)
DEFAULT_LABOUR_RATE_PER_DAY=40000
DEFAULT_BRICKS_PER_VEHICLE=2000
DEFAULT_BRICK_COST_PER_1000=55000

# Transport Cost Tiers (in rupees)
TRANSPORT_COST_SHORT_DISTANCE=70000
TRANSPORT_COST_MEDIUM_DISTANCE=120000
TRANSPORT_COST_LONG_DISTANCE=150000

# Currency
DEFAULT_CURRENCY=INR
